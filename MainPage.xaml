<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeManagementApp.MainPage"
             Title="Home">

    <VerticalStackLayout Padding="30" Spacing="30" VerticalOptions="Center">
        
        <!-- Weather Section -->
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="Weather in Vaasa:" FontSize="20" HorizontalOptions="Center" />
            <Label x:Name="TemperatureLabel" Text="Loading..." FontSize="36" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label x:Name="WindLabel" Text="Loading..." FontSize="20" HorizontalOptions="Center" />
            <Label x:Name="KiteLabel" Text="🪁 Kitesurf weather!" BackgroundColor="Yellow" TextColor="Black" FontSize="20" Padding="10" HorizontalOptions="Center" IsVisible="False" />
        </VerticalStackLayout>

        <!-- To-Do Section -->
        <VerticalStackLayout Spacing="10" HorizontalOptions="Fill">
            <Label Text="Top 3 To-Dos" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="Todo1Label" FontSize="16" />
            <Label x:Name="Todo2Label" FontSize="16" />
            <Label x:Name="Todo3Label" FontSize="16" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>