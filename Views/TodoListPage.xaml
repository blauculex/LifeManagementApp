<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeManagementApp.TodoListPage"
             Title="All To-Dos">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20" RowSpacing="15">
        
        <HorizontalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center">
            <Button Text="Sort by Priority" Clicked="OnSortByPriorityClicked" />
            <Button Text="Sort by Date" Clicked="OnSortByDateClicked" />
        </HorizontalStackLayout>

        <Button Grid.Row="1" Text="Add New To-Do" Clicked="OnAddClicked" />
        
        <!-- This replaces the CollectionView -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout x:Name="TodoListLayout" Spacing="10" />
        </ScrollView>

    </Grid>
</ContentPage>