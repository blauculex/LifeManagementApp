<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeManagementApp.TodoListPage"
             Title="All To-Dos">

    <VerticalStackLayout Padding="20" Spacing="15">
        
        <!-- Sorting Buttons -->
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button Text="Sort by Priority" Clicked="OnSortByPriorityClicked" />
            <Button Text="Sort by Date" Clicked="OnSortByDateClicked" />
        </HorizontalStackLayout>

        <!-- Add Button -->
        <Button Text="Add New To-Do" Clicked="OnAddClicked" />
        
        <CollectionView x:Name="TodoCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="{Binding Title}" FontSize="18" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding DueDate, StringFormat='Due: {0:MM/dd}'}" FontSize="14" TextColor="Gray" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>